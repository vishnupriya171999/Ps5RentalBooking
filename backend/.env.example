DATABASE_URL=postgresql://user:password@your-database-host/database
JWT_PRIVATE_KEY="replace with RSA private PEM; use \n for line breaks"
JWT_PUBLIC_KEY="replace with matching RSA public PEM; use \n for line breaks"

# Local host and port come from ../network.config.json.
# Conventional hosted Node servers use the platform's PORT and HOST (default 0.0.0.0).
# Vercel imports src/app.ts and does not need HOST or PORT.
# NODE_ENV=production
# PORT=8080
# HOST=0.0.0.0

# Comma-separated frontend origins, without paths or trailing slashes.
# Set this on the backend deployment. If unset, existing all-origin CORS is preserved.
# CORS_ORIGINS=https://your-frontend.example.com
