# Local development uses ../network.config.json; no .env is needed.
# For separate hosting, set this in the FRONTEND project's environment before building.
# Use the backend origin only, without /api/v1.
VITE_API_BASE_URL=https://your-backend.example.com

# Only needed when developing frontend/ without the shared network.config.json:
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=5173
